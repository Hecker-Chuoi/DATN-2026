# =============================================================================
# prod.env – BÍ MẬT + cấu hình production (dùng chung cho Hướng 1 và Hướng 2)
#
# KHÔNG commit file thật lên Git. Cách dùng:
#   1. Copy thành prod.env, điền giá trị thật.
#   2. Jenkins → Manage Jenkins → Credentials → Add → Kind "Secret file"
#      ID: datn-prod-env, upload file prod.env. Xoá bản trên máy sau khi upload.
#   - Hướng 1: Jenkins truyền file cho `docker compose --env-file`.
#   - Hướng 2: Jenkins tạo Kubernetes Secret "datn-secrets" từ file này.
#
# Quy tắc ghi: KEY=value, KHÔNG để dấu nháy, KHÔNG dùng ký tự $ trong mật khẩu
# (docker compose sẽ hiểu $ là biến). Sinh mật khẩu: openssl rand -base64 24 | tr -d '/+='
# =============================================================================

# ----- Tên miền (đã trỏ bản ghi A về Elastic IP của EC2) -----
APP_DOMAIN=datn.example.com
AUTH_DOMAIN=auth.datn.example.com

# ----- PostgreSQL của ứng dụng (datn_main_db: identity, work, workspace dùng chung) -----
APP_DB_USER=datn
APP_DB_PASSWORD=doi-mat-khau-manh-1

# ----- PostgreSQL riêng của Keycloak -----
KC_DB_USER=keycloak
KC_DB_PASSWORD=doi-mat-khau-manh-2

# ----- Tài khoản quản trị Keycloak (realm master) – identity-service dùng để tạo user -----
KC_ADMIN_USER=admin
KC_ADMIN_PASSWORD=doi-mat-khau-manh-3

# ----- Client secret của client "datn-backend" -----
# PHẢI khớp với secret trong realm export (infrastructure/keycloak/realm-export_08082026.json).
# Khuyến nghị: sau khi import, vào Keycloak → Clients → datn-backend → Credentials → Regenerate,
# rồi cập nhật giá trị mới vào đây (secret trong realm export đã nằm trên Git, coi như lộ).
KC_CLIENT_SECRET=dan-secret-cua-datn-backend-vao-day

# ----- MinIO (file đính kèm) -----
MINIO_ROOT_USER=datnminio
MINIO_ROOT_PASSWORD=doi-mat-khau-manh-4

# ----- SMTP thật để gửi mail xác thực / lời mời (ví dụ Gmail + App Password) -----
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=tai-khoan@gmail.com
MAIL_PASSWORD=app-password-16-ky-tu
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
MAIL_FROM=DATN-2026 <tai-khoan@gmail.com>
