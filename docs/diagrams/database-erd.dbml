// Ref: workspace_members.invited_by     > users.id
// Ref: teams.owner_id                   > users.id
// Ref: team_members.user_id             > users.id
// Ref: projects.lead_user_id            > users.id
// Ref: projects.created_by              > users.id
// Ref: project_clones.cloned_by         > users.id
// Ref: role_assignments.user_id         > users.id
// Ref: components.lead_user_id          > users.id
// Ref: sprint_report_snapshots.closed_by > users.id
// Ref: work_items.reporter_id           > users.id
// Ref: work_items.assignee_id           > users.id
// Ref: work_item_links.created_by       > users.id
// Ref: work_item_changelogs.changed_by  > users.id
// Ref: work_item_comments.author_id     > users.id
// Ref: work_item_attachments.uploaded_by > users.id
// Ref: saved_filters.owner_id           > users.id

// ============================================================================
// TABLE GROUPS — hiển thị ranh giới service trên canvas dbdiagram.io
// ============================================================================

TableGroup identity_service [note: 'identity-service — danh tính & RBAC toàn cục'] {
  users
  user_roles
}

TableGroup workspace_service [note: 'workspace-service — gốc tenant'] {
  workspaces
  workspace_members
}

TableGroup work_org [note: 'work-service — tổ chức: team, project, phân quyền'] {
  teams
  team_members
  projects
  project_clones
  project_roles
  role_assignments
  permission_scheme_entries
}

TableGroup work_config [note: 'work-service — cấu hình: type, workflow FSM, custom field'] {
  work_item_types
  statuses
  workflows
  workflow_transitions
  workflow_schemes
  workflow_scheme_mappings
  custom_field_definitions
}

TableGroup work_planning [note: 'work-service — lập kế hoạch: sprint, component, version, label'] {
  sprints
  sprint_report_snapshots
  components
  versions
  labels
}

TableGroup work_core [note: 'work-service — công việc & liên kết'] {
  work_items
  work_item_component_maps
  work_item_label_maps
  work_item_links
}

TableGroup work_board [note: 'work-service — bảng trực quan'] {
  boards
  board_columns
  board_column_statuses
  board_swimlanes
}

TableGroup work_activity [note: 'work-service — audit, thảo luận, tệp đính kèm'] {
  work_item_changelogs
  work_item_comments
  work_item_attachments
}

TableGroup work_platform [note: 'work-service — nền tảng: filter, automation, outbox'] {
  saved_filters
  automation_rules
  outbox_events
}
