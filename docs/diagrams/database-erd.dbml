// ============================================================================
// DATN-2026 — LƯỢC ĐỒ QUAN HỆ DATABASE (dbdiagram.io / DBML)
// Nguồn:
//   - identity-service : entity/User.java  (JPA ddl-auto)
//   - workspace-service: db/migration/V1, V2, V3
//   - work-service     : db/migration/V1__init_work_jira_schema.sql
//
// LƯU Ý VỀ KIẾN TRÚC MICROSERVICE:
//   Mỗi service sở hữu schema riêng. Các quan hệ cross-service (mọi cột trỏ tới
//   users.id, và workspace_id trong work-service) KHÔNG có FK vật lý trong DB —
//   trừ fk_teams_workspace / fk_projects_workspace do V3 của workspace-service
//   thêm vào (2 service dùng chung 1 PostgreSQL instance).
//   Trong lược đồ này các quan hệ logic cross-service được vẽ bằng nét đứt
//   (chú thích "logical") để phân biệt với FK thật.
// ============================================================================

Project DATN2026 {
  database_type: 'PostgreSQL'
  note: '''
    Hệ phân cấp: Workspace > Team > Project > Work Item (Epic > Story/Task/Bug > Subtask)
    - identity-service : users, user_roles
    - workspace-service: workspaces, workspace_members
    - work-service     : 30+ bảng (Jira-grade work engine)
  '''
}

// ============================================================================
// ENUM (giá trị được kiểm soát ở tầng ứng dụng, cột lưu VARCHAR)
// ============================================================================

Enum user_status {
  ACTIVE
  INACTIVE
  SUSPENDED
}

Enum workspace_member_role {
  OWNER
  ADMIN
  MEMBER
  GUEST
}

Enum team_member_role {
  LEADER
  MEMBER
  VIEWER
}

Enum project_type {
  SOFTWARE_SCRUM
  SOFTWARE_KANBAN
  BUSINESS
}

Enum status_category {
  TODO
  IN_PROGRESS
  DONE
}

Enum sprint_state {
  FUTURE
  ACTIVE
  CLOSED
}

Enum board_type {
  SCRUM
  KANBAN
}

Enum swimlane_strategy {
  BY_EPIC
  BY_ASSIGNEE
  BY_PRIORITY
  CUSTOM_JQL
}

Enum work_item_link_type {
  BLOCKS
  RELATES_TO
  DUPLICATES
  CAUSES
}

Enum work_item_priority {
  HIGHEST
  HIGH
  MEDIUM
  LOW
  LOWEST
}

Enum custom_field_type {
  TEXT
  NUMBER
  SELECT
  MULTI_SELECT
  DATE
  USER
  CHECKBOX
  URL
}

Enum outbox_status {
  PENDING
  PROCESSED
  FAILED
}

// ============================================================================
// IDENTITY SERVICE
// ============================================================================

Table users {
  id uuid [pk, default: `gen_random_uuid()`]
  keycloak_id varchar(36) [not null, unique, note: 'MUTABLE — có thể bị ghi lại khi email khớp Keycloak account khác. Không dùng làm khóa membership.']
  username varchar(100) [not null, unique]
  email varchar(255) [not null, unique]
  first_name varchar(100)
  last_name varchar(100)
  status user_status [not null, default: 'ACTIVE']
  created_at timestamp
  updated_at timestamp

  note: 'Nguồn sự thật duy nhất về danh tính. users.id là canonical user id dùng xuyên mọi service.'
}

Table user_roles {
  user_id uuid [not null, ref: > users.id]
  role varchar [not null, note: 'ROLE_USER, ROLE_ADMIN, ROLE_MANAGER — mirror realm roles của Keycloak']

  indexes {
    (user_id, role) [pk]
  }
}

// ============================================================================
// WORKSPACE SERVICE
// ============================================================================

Table workspaces {
  id uuid [pk, default: `gen_random_uuid()`]
  name varchar(255) [not null]
  slug varchar(100) [not null, unique]
  description text
  avatar_url varchar(500)
  created_by uuid [not null, note: 'logical -> users.id (không FK: cross-service). Chỉ dùng để audit, KHÔNG phải owner.']
  created_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]
  updated_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]
  deleted_at timestamptz [note: 'Soft delete có chủ đích: xóa cứng sẽ bỏ mồ côi teams/projects/work_items ở schema work-service.']

  indexes {
    created_by [name: 'idx_workspaces_created_by', note: 'partial: WHERE deleted_at IS NULL']
  }
  note: 'Gốc tenant. Không có cột owner_id — quyền sở hữu nằm ở workspace_members.role = OWNER.'
}

Table workspace_members {
  id uuid [pk, default: `gen_random_uuid()`]
  workspace_id uuid [not null, ref: > workspaces.id, note: 'ON DELETE CASCADE']
  user_id uuid [not null, note: 'logical -> users.id (LUÔN là identity users.id, KHÔNG BAO GIỜ là Keycloak sub)']
  role workspace_member_role [not null, default: 'MEMBER']
  invited_by uuid [note: 'logical -> users.id']
  joined_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
    (workspace_id, user_id) [unique, name: 'uq_workspace_member']
    user_id [name: 'idx_workspace_members_user']
    (workspace_id, role) [name: 'idx_workspace_members_role']
  }
  note: 'Nguồn sự thật duy nhất về vai trò. uq_workspace_member hiện thực hóa "1 user ở nhiều workspace, mỗi nơi 1 vai trò".'
}

// ============================================================================
// WORK SERVICE — 1. TEAMS
// ============================================================================

Table teams {
  id uuid [pk, default: `gen_random_uuid()`]
  workspace_id uuid [not null, ref: > workspaces.id, note: 'FK THẬT: fk_teams_workspace, ON DELETE RESTRICT (thêm bởi workspace-service V3)']
  name varchar(255) [not null]
  description text
  owner_id uuid [not null, note: 'logical -> users.id. Song trùng với team_members.role = LEADER (hai nguồn sự thật — cần hòa giải ở TeamController).']
  created_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]
  updated_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
    workspace_id [name: 'idx_teams_workspace']
    owner_id [name: 'idx_teams_owner']
  }
}

Table team_members {
  id uuid [pk, default: `gen_random_uuid()`]
  team_id uuid [not null, ref: > teams.id, note: 'ON DELETE CASCADE']
  user_id uuid [not null, note: 'logical -> users.id']
  role team_member_role [not null, default: 'MEMBER']
  joined_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
    (team_id, user_id) [unique, name: 'uq_team_member']
    user_id [name: 'idx_team_members_user']
  }
}

// ============================================================================
// WORK SERVICE — 2. PROJECTS & CLONES
// ============================================================================

Table projects {
  id uuid [pk, default: `gen_random_uuid()`]
  workspace_id uuid [not null, ref: > workspaces.id, note: 'FK THẬT: fk_projects_workspace, ON DELETE RESTRICT']
  team_id uuid [ref: > teams.id, note: 'ON DELETE SET NULL']
  name varchar(255) [not null]
  key varchar(20) [not null, unique, note: 'Mã tiền tố sinh code work item, vd DATN-123']
  description text
  icon_url varchar(500)
  lead_user_id uuid [not null, note: 'logical -> users.id']
  default_assignee_type varchar(50) [not null, default: 'PROJECT_LEADER']
  project_type project_type [not null, default: 'SOFTWARE_SCRUM']
  is_template boolean [not null, default: false]
  start_date date
  end_date date
  created_by uuid [not null, note: 'logical -> users.id']
  created_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]
  updated_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]
  deleted_at timestamptz [note: 'Soft delete + POST /{id}/restore']

  indexes {
    workspace_id [name: 'idx_projects_workspace', note: 'partial: WHERE deleted_at IS NULL']
    key [name: 'idx_projects_key']
    lead_user_id [name: 'idx_projects_lead', note: 'partial: WHERE deleted_at IS NULL']
  }
}

Table project_clones {
  id uuid [pk, default: `gen_random_uuid()`]
  source_project_id uuid [not null, ref: > projects.id, note: 'Template nguồn. ON DELETE CASCADE']
  cloned_project_id uuid [not null, ref: > projects.id, note: 'Dự án đích. ON DELETE CASCADE']
  cloned_by uuid [not null, note: 'logical -> users.id']
  cloned_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
    source_project_id [name: 'idx_project_clones_source']
    cloned_project_id [name: 'idx_project_clones_cloned']
  }
}

// ============================================================================
// WORK SERVICE — 3. PROJECT RBAC & PERMISSION SCHEME
// ============================================================================

Table project_roles {
  id uuid [pk, default: `gen_random_uuid()`]
  project_id uuid [ref: > projects.id, note: 'NULL = vai trò global dùng chung. ON DELETE CASCADE']
  name varchar(100) [not null, note: 'Admin, PM, Developer, QA, Viewer']
  description text
  created_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
    project_id [name: 'idx_project_roles_project']
  }
}

Table role_assignments {
  id uuid [pk, default: `gen_random_uuid()`]
  project_id uuid [not null, ref: > projects.id, note: 'ON DELETE CASCADE']
  user_id uuid [not null, note: 'logical -> users.id']
  role_id uuid [not null, ref: > project_roles.id, note: 'ON DELETE CASCADE']
  assigned_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
    (project_id, user_id, role_id) [unique, name: 'uq_user_project_role']
    (project_id, user_id) [name: 'idx_role_assignments_lookup']
  }
}

Table permission_scheme_entries {
  id uuid [pk, default: `gen_random_uuid()`]
  project_id uuid [not null, ref: > projects.id, note: 'ON DELETE CASCADE']
  role_id uuid [not null, ref: > project_roles.id, note: 'ON DELETE CASCADE']
  permission_key varchar(100) [not null, note: 'CREATE_ISSUE, SPRINT_MANAGE, ...']

  indexes {
    (project_id, role_id, permission_key) [unique, name: 'uq_perm_entry']
    (project_id, permission_key) [name: 'idx_perm_entries_lookup']
  }
  note: 'Ma trận quyền hạt mịn: vai trò nào trong dự án nào được làm gì.'
}

// ============================================================================
// WORK SERVICE — 4. WORK ITEM TYPES
// ============================================================================

Table work_item_types {
  id uuid [pk, default: `gen_random_uuid()`]
  project_id uuid [ref: > projects.id, note: 'NULL = type hệ thống dùng chung. ON DELETE CASCADE']
  name varchar(100) [not null]
  code varchar(50) [not null]
  description text
  icon_name varchar(100)
  color_hex varchar(20)
  hierarchy_level int [not null, note: '1 = Epic, 0 = Story/Task/Bug, -1 = Subtask']
  is_subtask boolean [not null, default: false]
  is_system_default boolean [not null, default: false]
  created_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
    project_id [name: 'idx_work_item_types_project']
    hierarchy_level [name: 'idx_work_item_types_level']
  }
}

// ============================================================================
// WORK SERVICE — 5. WORKFLOW ENGINE (FSM)
// ============================================================================

Table statuses {
  id uuid [pk, default: `gen_random_uuid()`]
  name varchar(100) [not null]
  category status_category [not null, note: 'Dùng để tính Burndown / Velocity / CFD']
  description text
  color_hex varchar(20)
  created_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]

  note: 'Bảng global — không gắn project_id.'
}

Table workflows {
  id uuid [pk, default: `gen_random_uuid()`]
  project_id uuid [ref: > projects.id, note: 'ON DELETE CASCADE']
  name varchar(255) [not null]
  description text
  is_default boolean [not null, default: false]
  created_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]
  updated_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
    project_id [name: 'idx_workflows_project']
  }
}

Table workflow_transitions {
  id uuid [pk, default: `gen_random_uuid()`]
  workflow_id uuid [not null, ref: > workflows.id, note: 'ON DELETE CASCADE']
  from_status_id uuid [ref: > statuses.id, note: 'NULL = transition khởi tạo (initial). ON DELETE CASCADE']
  to_status_id uuid [not null, ref: > statuses.id, note: 'ON DELETE CASCADE']
  name varchar(150) [not null]
  conditions_config jsonb
  validators_config jsonb
  post_functions_config jsonb

  indexes {
    workflow_id [name: 'idx_transitions_workflow']
    (workflow_id, from_status_id, to_status_id) [name: 'idx_transitions_from_to']
  }
}

Table workflow_schemes {
  id uuid [pk, default: `gen_random_uuid()`]
  project_id uuid [not null, ref: > projects.id, note: 'ON DELETE CASCADE']
  name varchar(255) [not null]
  description text
  created_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]
}

Table workflow_scheme_mappings {
  id uuid [pk, default: `gen_random_uuid()`]
  scheme_id uuid [not null, ref: > workflow_schemes.id, note: 'ON DELETE CASCADE']
  work_item_type_id uuid [not null, ref: > work_item_types.id, note: 'ON DELETE CASCADE']
  workflow_id uuid [not null, ref: > workflows.id, note: 'ON DELETE CASCADE']

  indexes {
    (scheme_id, work_item_type_id) [unique, name: 'uq_scheme_item_type']
  }
  note: 'Ánh xạ: trong scheme này, loại công việc X dùng workflow Y.'
}

// ============================================================================
// WORK SERVICE — 6. SPRINT / COMPONENT / VERSION / LABEL
// ============================================================================

Table sprints {
  id uuid [pk, default: `gen_random_uuid()`]
  project_id uuid [not null, ref: > projects.id, note: 'ON DELETE CASCADE']
  name varchar(255) [not null]
  goal text
  state sprint_state [not null, default: 'FUTURE']
  start_date timestamptz
  end_date timestamptz
  completed_date timestamptz
  created_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]
  updated_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
    (project_id, state) [name: 'idx_sprints_project_state']
  }
}

Table sprint_report_snapshots {
  id uuid [pk, default: `gen_random_uuid()`]
  sprint_id uuid [not null, unique, ref: - sprints.id, note: '1-1 với sprint. ON DELETE CASCADE']
  total_story_points decimal(10,2) [default: 0]
  completed_story_points decimal(10,2) [default: 0]
  incomplete_story_points decimal(10,2) [default: 0]
  total_items int [default: 0]
  completed_items int [default: 0]
  snapshot_data jsonb [not null]
  closed_by uuid [not null, note: 'logical -> users.id']
  closed_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]

  note: 'Đóng băng số liệu lúc đóng sprint để vẽ Burndown & Velocity vĩnh viễn.'
}

Table components {
  id uuid [pk, default: `gen_random_uuid()`]
  project_id uuid [not null, ref: > projects.id, note: 'ON DELETE CASCADE']
  name varchar(255) [not null]
  description text
  lead_user_id uuid [note: 'logical -> users.id. Dùng cho auto-assign mặc định.']
  created_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
    (project_id, name) [unique, name: 'uq_project_component_name']
    project_id [name: 'idx_components_project']
  }
}

Table versions {
  id uuid [pk, default: `gen_random_uuid()`]
  project_id uuid [not null, ref: > projects.id, note: 'ON DELETE CASCADE']
  name varchar(255) [not null]
  description text
  release_date date
  is_released boolean [not null, default: false]
  is_archived boolean [not null, default: false]
  created_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
    (project_id, name) [unique, name: 'uq_project_version_name']
    project_id [name: 'idx_versions_project']
  }
  note: 'Đợt phát hành, độc lập với Sprint. Tự sinh Release Notes Markdown.'
}

Table labels {
  id uuid [pk, default: `gen_random_uuid()`]
  project_id uuid [not null, ref: > projects.id, note: 'ON DELETE CASCADE']
  name varchar(100) [not null]
  color_hex varchar(20) [default: '#6B7280']
  created_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
    (project_id, name) [unique, name: 'uq_project_label_name']
    (project_id, name) [name: 'idx_labels_project_name']
  }
}

// ============================================================================
// WORK SERVICE — 7. WORK ITEMS (THỰC THỂ TRUNG TÂM)
// ============================================================================

Table work_items {
  id uuid [pk, default: `gen_random_uuid()`]
  project_id uuid [not null, ref: > projects.id, note: 'ON DELETE CASCADE']
  type_id uuid [not null, ref: > work_item_types.id]
  status_id uuid [not null, ref: > statuses.id]
  parent_id uuid [ref: > work_items.id, note: 'Tự tham chiếu: Epic -> Story -> Subtask. ON DELETE SET NULL']
  sprint_id uuid [ref: > sprints.id, note: 'NULL = còn trong Backlog. ON DELETE SET NULL']

  code varchar(50) [not null, note: 'vd DATN-123, unique trong phạm vi project']
  summary varchar(500) [not null]
  description text

  priority work_item_priority [not null, default: 'MEDIUM']
  resolution varchar(100)

  reporter_id uuid [not null, note: 'logical -> users.id']
  assignee_id uuid [note: 'logical -> users.id']

  story_points decimal(6,2)
  original_estimate_seconds bigint [default: 0]
  remaining_estimate_seconds bigint [default: 0]
  time_spent_seconds bigint [default: 0]

  rank varchar(255) [not null, note: 'LexoRank — sắp xếp thủ công không cần reindex hàng loạt']

  component_id uuid [ref: > components.id, note: 'Component chính. ON DELETE SET NULL']
  fix_version_id uuid [ref: > versions.id, note: 'ON DELETE SET NULL']

  custom_fields jsonb [default: `'{}'::jsonb`, note: 'Giá trị trường động, index GIN']

  start_date date
  due_date date

  resolved_at timestamptz
  version int [not null, default: 0, note: 'Optimistic locking (@Version)']
  created_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]
  updated_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]
  deleted_at timestamptz [note: 'Soft delete']

  indexes {
    (project_id, code) [unique, name: 'uq_project_work_item_code']
    project_id [name: 'idx_work_items_project', note: 'partial: WHERE deleted_at IS NULL']
    sprint_id [name: 'idx_work_items_sprint', note: 'partial: WHERE deleted_at IS NULL']
    parent_id [name: 'idx_work_items_parent', note: 'partial: WHERE deleted_at IS NULL']
    status_id [name: 'idx_work_items_status']
    assignee_id [name: 'idx_work_items_assignee', note: 'partial: WHERE deleted_at IS NULL']
    type_id [name: 'idx_work_items_type', note: 'partial: WHERE deleted_at IS NULL']
    (project_id, rank) [name: 'idx_work_items_rank']
    custom_fields [type: gin, name: 'idx_work_items_custom_fields_gin']
  }
  note: 'Hợp nhất Epic / Story / Task / Bug / Subtask vào một bảng, phân biệt bằng type_id.hierarchy_level.'
}

Table work_item_component_maps {
  work_item_id uuid [not null, ref: > work_items.id, note: 'ON DELETE CASCADE']
  component_id uuid [not null, ref: > components.id, note: 'ON DELETE CASCADE']

  indexes {
    (work_item_id, component_id) [pk]
  }
  note: 'N-N: gắn thêm nhiều component phụ ngoài work_items.component_id.'
}

Table work_item_label_maps {
  work_item_id uuid [not null, ref: > work_items.id, note: 'ON DELETE CASCADE']
  label_id uuid [not null, ref: > labels.id, note: 'ON DELETE CASCADE']

  indexes {
    (work_item_id, label_id) [pk]
  }
}

// ============================================================================
// WORK SERVICE — 8. LINKED ISSUES
// ============================================================================

Table work_item_links {
  id uuid [pk, default: `gen_random_uuid()`]
  source_item_id uuid [not null, ref: > work_items.id, note: 'ON DELETE CASCADE']
  target_item_id uuid [not null, ref: > work_items.id, note: 'ON DELETE CASCADE']
  link_type work_item_link_type [not null]
  created_by uuid [not null, note: 'logical -> users.id']
  created_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
    (source_item_id, target_item_id, link_type) [unique, name: 'uq_work_item_link']
    source_item_id [name: 'idx_item_links_source']
    target_item_id [name: 'idx_item_links_target']
  }
  note: 'CHECK chk_no_self_link: source_item_id <> target_item_id'
}

// ============================================================================
// WORK SERVICE — 9. BOARDS / COLUMNS / SWIMLANES
// ============================================================================

Table boards {
  id uuid [pk, default: `gen_random_uuid()`]
  project_id uuid [not null, ref: > projects.id, note: 'ON DELETE CASCADE']
  name varchar(255) [not null]
  type board_type [not null, default: 'SCRUM']
  filter_jql text
  created_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]
  updated_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
    project_id [name: 'idx_boards_project']
  }
}

Table board_columns {
  id uuid [pk, default: `gen_random_uuid()`]
  board_id uuid [not null, ref: > boards.id, note: 'ON DELETE CASCADE']
  name varchar(150) [not null]
  column_order int [not null]
  min_wip_limit int
  max_wip_limit int
  created_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
    (board_id, column_order) [name: 'idx_board_columns_board_order']
  }
}

Table board_column_statuses {
  column_id uuid [not null, ref: > board_columns.id, note: 'ON DELETE CASCADE']
  status_id uuid [not null, ref: > statuses.id, note: 'ON DELETE CASCADE']

  indexes {
    (column_id, status_id) [pk]
  }
  note: 'N-N: 1 cột Board gom nhiều status thực tế (vd cột "In Progress" gom IN_PROGRESS + IN_REVIEW).'
}

Table board_swimlanes {
  id uuid [pk, default: `gen_random_uuid()`]
  board_id uuid [not null, ref: > boards.id, note: 'ON DELETE CASCADE']
  name varchar(150) [not null]
  strategy swimlane_strategy [not null]
  custom_jql text
  swimlane_order int [not null]

  indexes {
    (board_id, swimlane_order) [name: 'idx_swimlanes_board']
  }
}

// ============================================================================
// WORK SERVICE — 10. AUDIT / COMMENTS / ATTACHMENTS
// ============================================================================

Table work_item_changelogs {
  id uuid [pk, default: `gen_random_uuid()`]
  work_item_id uuid [not null, ref: > work_items.id, note: 'ON DELETE CASCADE']
  field_name varchar(100) [not null]
  old_value text
  new_value text
  changed_by uuid [not null, note: 'logical -> users.id']
  changed_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
    (work_item_id, changed_at) [name: 'idx_changelog_item_time']
  }
  note: 'Lưu vết từng trường — cho phép dựng lại Burndown/CFD tại bất kỳ thời điểm.'
}

Table work_item_comments {
  id uuid [pk, default: `gen_random_uuid()`]
  work_item_id uuid [not null, ref: > work_items.id, note: 'ON DELETE CASCADE']
  parent_comment_id uuid [ref: > work_item_comments.id, note: 'Tự tham chiếu: cây thảo luận. ON DELETE CASCADE']
  author_id uuid [not null, note: 'logical -> users.id']
  body text [not null]
  created_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]
  updated_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]
  deleted_at timestamptz

  indexes {
    work_item_id [name: 'idx_comments_item', note: 'partial: WHERE deleted_at IS NULL']
  }
}

Table work_item_attachments {
  id uuid [pk, default: `gen_random_uuid()`]
  work_item_id uuid [not null, ref: > work_items.id, note: 'ON DELETE CASCADE']
  file_name varchar(255) [not null]
  file_url varchar(1000) [not null]
  file_size bigint [not null]
  content_type varchar(100)
  uploaded_by uuid [not null, note: 'logical -> users.id']
  uploaded_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
    work_item_id [name: 'idx_attachments_item']
  }
}

// ============================================================================
// WORK SERVICE — 11. CUSTOM FIELDS / FILTERS / AUTOMATION / OUTBOX
// ============================================================================

Table custom_field_definitions {
  id uuid [pk, default: `gen_random_uuid()`]
  project_id uuid [ref: > projects.id, note: 'NULL = trường global. ON DELETE CASCADE']
  field_key varchar(100) [not null, note: 'Khóa tra trong work_items.custom_fields JSONB']
  name varchar(255) [not null]
  field_type custom_field_type [not null]
  options jsonb
  validation_rules jsonb
  applicable_type_ids "uuid[]" [note: 'Mảng work_item_types.id — quan hệ mềm, không FK được vì là array']
  created_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
    (project_id, field_key) [unique, name: 'uq_proj_field_key']
    project_id [name: 'idx_custom_field_defs_project']
  }
}

Table saved_filters {
  id uuid [pk, default: `gen_random_uuid()`]
  project_id uuid [ref: > projects.id, note: 'NULL = filter cross-project. ON DELETE CASCADE']
  name varchar(255) [not null]
  description text
  jql_query text [not null]
  owner_id uuid [not null, note: 'logical -> users.id']
  is_shared boolean [not null, default: false]
  created_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
    owner_id [name: 'idx_saved_filters_owner']
  }
}

Table automation_rules {
  id uuid [pk, default: `gen_random_uuid()`]
  project_id uuid [not null, ref: > projects.id, note: 'ON DELETE CASCADE']
  name varchar(255) [not null]
  trigger_type varchar(100) [not null]
  conditions_config jsonb
  actions_config jsonb
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]
  updated_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
    (project_id, is_active) [name: 'idx_automation_project']
  }
  note: 'Trigger -> Condition -> Action.'
}

Table outbox_events {
  id uuid [pk, default: `gen_random_uuid()`]
  aggregate_type varchar(100) [not null]
  aggregate_id varchar(100) [not null, note: 'ID của aggregate (work_item, project...) dạng string — quan hệ mềm, không FK']
  event_type varchar(100) [not null]
  payload jsonb [not null]
  status outbox_status [not null, default: 'PENDING']
  retry_count int [default: 0]
  created_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]
  processed_at timestamptz

  indexes {
    (status, created_at) [name: 'idx_outbox_status_time', note: "partial: WHERE status = 'PENDING'"]
  }
  note: 'Transactional Outbox — phát hành sự kiện lên Kafka mà không bị lỗi Dual-Write.'
}

// ============================================================================
// QUAN HỆ LOGIC CROSS-SERVICE (KHÔNG có FK vật lý — vẽ để thấy luồng dữ liệu)
// Bỏ comment nếu muốn dbdiagram vẽ các đường nối tới users.
// ============================================================================

