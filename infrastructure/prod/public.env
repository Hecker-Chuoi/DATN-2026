# CẤU HÌNH CÔNG KHAI CỦA MÔI TRƯỜNG PRODUCTION — nơi DUY NHẤT ghi tên miền, giao thức, registry.
# Không chứa bí mật (mật khẩu nằm ở ~/datn/secrets.env trên server, KHÔNG commit). Commit file này.
# Docker compose đọc file này cùng secrets.env (--env-file ... --env-file ...); build-push.sh đọc SCHEME, SSO_HOST, REGISTRY.
#
# Sửa nhanh bằng script (ở máy dev, gốc repo, rồi commit):
#   bash infrastructure/prod/scripts/set-public-host.sh <tên-miền-gốc> <http|https> <tài-khoản-dockerhub>

# Giao thức: https khi Nginx của server đã có chứng chỉ. ĐỔI SAU KHI CÀI = Keycloak đổi `iss` → mọi người đăng nhập lại.
SCHEME=https
# Tên miền người dùng mở ứng dụng và tên miền Keycloak (đăng nhập / Admin Console)
APP_HOST=app.16-179-211-188.sslip.io
SSO_HOST=sso.16-179-211-188.sslip.io
# Nơi GitHub Actions push image: docker.io/<tài-khoản-dockerhub>
REGISTRY=docker.io/yamaaaaaaaa

# Cookie đăng nhập chỉ gửi qua HTTPS: đặt true khi SCHEME=https
COOKIE_SECURE=true

# Gửi mail: mặc định Mailpit trong compose (không gửi đi thật, xem ở http://127.0.0.1:8025 qua đường hầm SSH).
# Dùng SMTP thật (Gmail): MAIL_HOST=smtp.gmail.com, MAIL_PORT=587, MAIL_SMTP_AUTH=true, MAIL_SMTP_STARTTLS=true
# rồi điền MAIL_USERNAME / MAIL_PASSWORD vào secrets.env. Xem docs/cicd/cac_buoc/03.
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false
MAIL_FROM="DATN-2026 <no-reply@datn.local>"

# Tích hợp GitHub (work-service): Client ID của GitHub OAuth App (KHÔNG bí mật). Để trống = chưa dùng tính năng GitHub.
# Callback URL của OAuth App phải là  ${SCHEME}://${APP_HOST}/integrations/github/callback  (docs/cicd/cac_buoc/03 mục 5b).
# Client Secret + khoá mã hoá token nằm ở secrets.env (GITHUB_CLIENT_SECRET, GITHUB_TOKEN_ENCRYPTION_KEY, GITHUB_STATE_SECRET).
GITHUB_CLIENT_ID=
