# Copy thành .env (gitignored) rồi điền giá trị thật. KHÔNG commit .env.
# OAuth App: GitHub > Settings > Developer settings > OAuth Apps > New OAuth App
#   Homepage URL:               http://localhost:5173
#   Authorization callback URL: http://localhost:5173/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Bí mật ký webhook, tự sinh:   openssl rand -hex 20
GITHUB_WEBHOOK_SECRET=
# Key mã hóa token (base64 32 byte): openssl rand -base64 32   (đổi key = user phải kết nối lại)
GITHUB_TOKEN_ENC_KEY=
# URL public của gateway để GitHub gọi webhook (ngrok http 9991 khi dev; bỏ trống thì hook tạo được nhưng deliver lỗi)
APP_PUBLIC_URL=https://xxxx.ngrok-free.app
